APP_NAME=ops-copilot-platform
APP_ENVIRONMENT=local
DIAGNOSIS_STORE_CAPACITY=500
DIAGNOSIS_RETENTION_SECONDS=3600
LOG_LEVEL=INFO
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
