LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2500
LLM_MAX_PROMPT_CHARS=200000
LLM_MAX_RESPONSE_BYTES=2000000
AGENT_MAX_STEPS=18
AGENT_MAX_TOOL_CALLS=4
LOG_WINDOW_BEFORE_MINUTES=15
LOG_WINDOW_AFTER_MINUTES=5
LOG_RESULT_LIMIT=30
